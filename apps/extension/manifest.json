{
  "manifest_version": 3,
  "name": "ClearView — Page Guard",
  "version": "1.0.0",
  "description": "Inspect visible fees, selected add-ons, and accessibility issues. Apply reversible local page repairs.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "activeTab", "scripting"],
  "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"},
  "action": {"default_title": "Open ClearView for this page", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}},
  "background": {"service_worker": "background.js"},
  "side_panel": {"default_path": "index.html"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"}
}
