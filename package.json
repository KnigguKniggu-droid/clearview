{
  "name": "clearview",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev -w @clearview/web-sandbox --",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "verify": "npm test && npm run lint && npm run typecheck && npm run build",
    "test:e2e": "playwright test",
    "test:extension-runtime": "node tests/browser/extension-runtime.mjs",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.5",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.74.0",
    "vite": "^6.4.6",
    "vitest": "^2.1.0"
  },
  "overrides": {
    "vite": "$vite"
  }
}
